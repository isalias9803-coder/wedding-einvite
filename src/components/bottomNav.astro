
<nav
  id="bottom-nav"
  aria-label="Wedding invitation navigation"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-[#C69A55]/50 bg-[#F7F0E3]/95 backdrop-blur-md md:hidden"
>
  <div
    class="mx-auto flex max-w-lg items-center justify-around px-2 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]"
  >
    <a href="/#welcome" class="nav-link" data-target="welcome" aria-current="page">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/>
      </svg>
      <span>Home</span>
    </a>

    <a href="/#invitation" class="nav-link" data-target="invitation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m3 7 9 6 9-6"/>
      </svg>
      <span>Invite</span>
    </a>

    <a href="/#details" class="nav-link" data-target="details">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <rect x="3" y="5" width="18" height="16" rx="2"/>
        <path d="M16 3v4M8 3v4M3 10h18M8 14h3"/>
      </svg>
      <span>Details</span>
    </a>

    <a href="/#location" class="nav-link" data-target="location">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
        <circle cx="12" cy="10" r="2.5"/>
      </svg>
      <span>Location</span>
    </a>

    <a href="/#rsvp" class="nav-link" data-target="rsvp">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M8 3h8l4 4v14H4V3z"/>
        <path d="M14 3v5h5M8 13h8M8 17h5"/>
      </svg>
      <span>RSVP</span>
    </a>
  </div>
</nav>

<style>
  .nav-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: #79533D;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-link svg {
    width: 21px;
    height: 21px;
  }

  .nav-link[aria-current="page"] {
    color: #C94D35;
    font-weight: 700;
  }

  .nav-link:active {
    transform: scale(0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }
</style>

<script>
  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>(".nav-link");

  const mainContainer =
    document.querySelector<HTMLElement>("main");

  const sections =
    document.querySelectorAll<HTMLElement>("main section[id]");

  // Update the active navigation item
  function setActiveLink(sectionId: string) {
    navLinks.forEach((link) => {
      if (link.dataset.target === sectionId) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Smooth navigation when a guest taps an item
  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const targetId = link.dataset.target;
      const target = targetId
        ? document.getElementById(targetId)
        : null;

      if (target && mainContainer) {
        event.preventDefault();

        target.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });

        history.replaceState(null, "", `#${targetId}`);
        setActiveLink(targetId!);
      }
    });
  });

  // Automatically highlight the section currently being viewed
  if ("IntersectionObserver" in window && mainContainer) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleSections = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              b.intersectionRatio - a.intersectionRatio
          );

        if (visibleSections.length > 0) {
          setActiveLink(visibleSections[0].target.id);
        }
      },
      {
        root: mainContainer,
        threshold: [0.2, 0.4, 0.6],
      }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
