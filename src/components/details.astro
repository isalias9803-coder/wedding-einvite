
<section
  id="details"
  class="w-full min-h-dvh flex flex-col items-center justify-center  px-5 py-12"
>
  <!-- Section Heading -->
  <p class="mb-3 text-xs tracking-[0.3em] text-[#C69A55]">
    THE CELEBRATION
  </p>

  <h2 class="mb-8 font-serif text-4xl text-[#79533D]">
    Wedding Details
  </h2>

  <!-- Decorative Divider -->
  <div class="mb-8 flex w-full max-w-xs items-center gap-3">
    <span class="h-px flex-1 bg-[#C69A55]/60"></span>
    <span class="text-[#C69A55]">✦</span>
    <span class="h-px flex-1 bg-[#C69A55]/60"></span>
  </div>

  <!-- Wedding Date -->
  <div class="mb-7 text-center">
    <p class="mb-2 text-xs tracking-[0.2em] text-[#C69A55]">
      DATE
    </p>
    <h3 class="font-serif text-2xl text-[#242222]">
      27 December 2026
    </h3>
    <p class="mt-1 text-sm italic text-[#79533D]">
      Sunday
    </p>
  </div>

  <!-- Guest Arrival -->
  <div class="mb-7 text-center">
    <p class="mb-2 text-xs tracking-[0.2em] text-[#C69A55]">
      GUEST ARRIVAL
    </p>
    <h3 class="font-serif text-2xl text-[#242222]">
      6:30 PM
    </h3>
  </div>

  <!-- Venue -->
  <div class="mb-7 text-center">
    <p class="mb-2 text-xs tracking-[0.2em] text-[#C69A55]">
      VENUE
    </p>
    <h3 class="font-serif text-xl text-[#242222]">
      Tiara Hotel Labuan
    </h3>
    <p class="mt-1 text-sm text-[#79533D]">
      Grand Ballroom
    </p>
  </div>
 
{/* Wedding Theme */}
<div class="mt-2 w-full max-w-sm border border-[#C69A55]/60 px-4 py-5 text-center">
  <p class="mb-5 text-xs tracking-[0.2em] text-[#C69A55]">
    WEDDING THEME
  </p>

  <div class="grid grid-cols-2 gap-4">
    {/* Ladies */}
    <div class="flex flex-col items-center">
      <img
        src={`${import.meta.env.BASE_URL}/images/kebaya.png`}
        alt="Traditional Kebaya attire"
        class="mb-3 h-28 w-full object-contain"
      />
      <h3 class="font-serif text-2xl text-[#C94D35]">Ladies</h3>
      <p class="mt-1 text-xs text-[#79533D]">
        Kebaya / Traditional Attire
      </p>
    </div>

    {/* Gentlemen */}
    <div class="flex flex-col items-center">
      <img
        src={`${import.meta.env.BASE_URL}/images/baju-batik.png`}
        alt="Traditional Peranakan-inspired Baju Batik"
        class="mb-3 h-28 w-full object-contain"
      />
      <h3 class="font-serif text-2xl text-[#C94D35]">Gentlemen</h3>
      <p class="mt-1 text-xs text-[#79533D]">
        Baju Batik / Traditional Attire
      </p>
    </div>
  </div>

  <p class="mt-5 text-sm italic text-[#79533D]">
    Dress to celebrate in traditional elegance
  </p>
</div>

</section>
