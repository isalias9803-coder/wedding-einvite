---
import '../styles/global.css'
---



<section 
id = "invitation"
class="w-full min-h-dvh flex flex-col items-center justify-start bg-[#F7F0E3] px-4 pt-5 pb-6">

  <p class="mb-3 text-xs tracking-[0.25em] text-[#C69A55]">
    A CELEBRATION OF LOVE
  </p>

  <h1 class="mb-5 font-serif text-3xl italic text-[#79533D]">
    You're Invited
  </h1>

  <img
    src={`${import.meta.env.BASE_URL}images/invitation.png`}
    alt="Wedding invitation"
    class="w-full max-w-[600px] max-h-[65dvh] object-contain"
  />

  <p class="mt-5 text-xs tracking-[0.2em] text-[#79533D]">
    SCROLL TO EXPLORE
  </p>

  <span class="mt-2 text-xl text-[#C69A55] animate-bounce">
    ↓
  </span>

</section>

