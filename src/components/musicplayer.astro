
<div class="music-player fixed bottom-24 right-5 md:bottom-6 z-50">
  <span class="music-flower flower-top">✿</span>
  <span class="music-flower flower-bottom">❀</span>

  <button
    id="music-toggle"
    type="button"
    class="music-button"
    aria-label="Play wedding music"
    title="Play wedding music"
  >
    <span id="vinyl-disc" class="vinyl-disc">
      <span class="vinyl-label">
        <span class="vinyl-center"></span>
      </span>
    </span>

    <span id="music-icon" class="music-icon">▶</span>
  </button>
</div>

<audio
  id="wedding-audio"
  src="/music/wedding-song.mp3"
  loop
  preload="metadata"
></audio>

<style>
  
.music-player {
  position: fixed;
  z-index: 50;
}

/* Music button */
.music-button {
  position: relative;
  width: 64px;
  height: 64px;
  border: 1px solid #C69A55;
  border-radius: 50%;
  background: #F7F0E3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px #24222225;
  cursor: pointer;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.music-button:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 18px #24222235;
}

/* Antique-gold outer ring */
.music-button::before {
  content: "";
  position: absolute;
  inset: -5px;
  border: 1px solid #C69A55;
  border-radius: 50%;
  opacity: 0.75;
  pointer-events: none;
}

/* Vinyl record */
.vinyl-disc {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;

  background:
    repeating-radial-gradient(
      circle,
      #39312D 0px,
      #39312D 2px,
      #51443D 3px,
      #292421 4px
    );

  box-shadow: inset 0 0 5px #000;
}

/* Coral vinyl label */
.vinyl-label {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #C94D35;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Centre hole */
.vinyl-center {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #F7F0E3;
}

/* Play / Pause indicator */
.music-icon {
  position: absolute;
  color: #F7F0E3;
  font-size: 13px;
  background: #C94D35;
  border-radius: 50%;
  width: 25px;
  height: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #F7F0E3;
  right: -3px;
  bottom: -3px;
}

/* Vinyl rotation while playing */
.vinyl-disc.is-playing {
  animation: vinyl-spin 4s linear infinite;
}

@keyframes vinyl-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* Peranakan floral decorations */
.music-flower {
  position: absolute;
  z-index: 2;
  pointer-events: none;
  font-size: 19px;
  color: #C69A55;
  text-shadow: 0 1px 2px #79533D30;
}

.flower-top {
  top: -10px;
  right: -8px;
  transform: rotate(15deg);
  color: #C94D35;
}

.flower-bottom {
  bottom: -8px;
  left: -9px;
  transform: rotate(-20deg);
  font-size: 17px;
  color: #C69A55;
}

/* Accessibility: respect reduced-motion settings */
@media (prefers-reduced-motion: reduce) {
  .vinyl-disc.is-playing {
    animation: none;
  }

  .music-button {
    transition: none;
  }
}

</style>

<script>
  const audio = document.querySelector<HTMLAudioElement>("#wedding-audio");
  const button = document.querySelector<HTMLButtonElement>("#music-toggle");
  const disc = document.querySelector<HTMLSpanElement>("#vinyl-disc");
  const icon = document.querySelector<HTMLSpanElement>("#music-icon");

  if (audio && button && disc && icon) {
    const updateButton = () => {
      const playing = !audio.paused;

      disc.classList.toggle("is-playing", playing);
      icon.textContent = playing ? "Ⅱ" : "▶";

      button.setAttribute(
        "aria-label",
        playing ? "Pause wedding music" : "Play wedding music"
      );

      button.setAttribute(
        "title",
        playing ? "Pause wedding music" : "Play wedding music"
      );
    };

    button.addEventListener("click", async () => {
      if (audio.paused) {
        try {
          await audio.play();
        } catch {
          console.error("Unable to play wedding music.");
        }
      } else {
        audio.pause();
      }

      updateButton();
    });

    audio.addEventListener("play", updateButton);
    audio.addEventListener("pause", updateButton);
    audio.addEventListener("ended", updateButton);

    audio.play().catch(() => updateButton());
  }
</script>
