
---
const groom = "Isa";
const bride = "Hafizah";
---

<section
  id="welcome"
  class="relative flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden bg-[#8fc9c3] px-5 py-12 text-center"
>
  <!-- Decorative frame -->
  <div class="absolute inset-3 rounded-2xl border border-[#c6a15b]/70"></div>
  <div class="absolute inset-5 rounded-xl border border-white/50"></div>

  <!-- Main content -->
  <div class="relative z-10 flex flex-col items-center">

    <p class="mb-4 text-xs tracking-[0.4em] text-[#315d5a]">
      YOU ARE CORDIALLY INVITED
    </p>

    <h1 class="font-serif text-4xl text-[#315d5a] sm:text-6xl">
      {groom} <span class="text-[#c6a15b]">&</span> {bride}
    </h1>

    <p class="mt-3 text-sm tracking-[0.25em] text-[#315d5a]">
      THE WEDDING CELEBRATION
    </p>

    <!-- Interactive envelope -->
    <div class="mt-12 flex flex-col items-center">

      <input
        type="checkbox"
        id="open-invite"
        class="peer sr-only"
      />

      <div class="envelope relative h-36 w-56 sm:h-44 sm:w-72">

        <!-- Envelope body -->
        <div class="absolute inset-0 rounded-md border border-[#c6a15b] bg-[#fffaf0] shadow-xl"></div>

        <!-- Letter -->
        <div class="letter absolute inset-x-5 bottom-3 z-10 flex h-24 flex-col items-center justify-center bg-white text-[#315d5a] sm:h-28">
          <span class="font-serif text-xl">{groom} & {bride}</span>
          <span class="mt-1 text-[9px] tracking-widest">WEDDING INVITATION</span>
        </div>

        <!-- Envelope flap -->
        <div class="flap absolute inset-x-0 top-0 z-20 h-0 border-x-[112px] border-t-[75px] border-x-transparent border-t-[#e8a6ad] sm:border-x-[144px] sm:border-t-[90px]"></div>

        <!-- Envelope front -->
        <div class="absolute inset-x-0 bottom-0 z-30 h-0 border-x-[112px] border-b-[90px] border-x-transparent border-b-[#f5d9d5] sm:border-x-[144px] sm:border-b-[110px]"></div>

      </div>

      <!-- Open button -->
      <label
        for="open-invite"
        class="mt-10 cursor-pointer rounded-full border border-[#315d5a] px-8 py-3 text-sm tracking-widest text-[#315d5a] transition duration-300 hover:bg-[#315d5a] hover:text-white"
      >
        <span class="peer-checked:hidden">OPEN INVITATION</span>
      </label>

      <p class="mt-4 text-xs tracking-widest text-[#315d5a]/70">
        A CELEBRATION OF LOVE & HERITAGE
      </p>

    </div>
  </div>

  <!-- Decorative corner details -->
  <span class="absolute left-8 top-8 text-3xl text-[#c6a15b]">❀</span>
  <span class="absolute right-8 top-8 text-3xl text-[#c6a15b]">❀</span>
  <span class="absolute bottom-8 left-8 text-3xl text-[#c6a15b]">❀</span>
  <span class="absolute bottom-8 right-8 text-3xl text-[#c6a15b]">❀</span>
</section>

<style>
  .letter {
    transition: transform 700ms ease;
  }

  .flap {
    transform-origin: top;
    transition: transform 600ms ease;
  }

  #open-invite:checked ~ .envelope .flap {
    transform: rotateX(180deg);
  }

  #open-invite:checked ~ .envelope .letter {
    transform: translateY(-65px);
  }
</style>
