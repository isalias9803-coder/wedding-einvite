
---
const groom = "Isa";
const bride = "Hafizah";

---
<section 
id="welcome"
class="w-full h-screen flex flex-col justify-center items-center bg-gradient-to-b from-[#fdf6f0] to-[#f9e8e0]"
style={`background-image: url('${import.meta.env.BASE_URL}/images/bg.jpg'); background-size: cover; background-position: center;`}>
 <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/50"></div>

  <!-- Text content -->
  <div class="relative z-10 px-5 text-center text-white">
  <p class="text-sm tracking-[0.4em] drop-shadow-lg">
    THE WEDDING OF
  </p>

  <h1 class="mt-6 font-serif text-5xl sm:text-6xl drop-shadow-lg">
    Isa <span class="text-[#e5c27a]">&</span> Hafizah
  </h1>

  <div class="mx-auto my-6 h-px w-20 bg-[#e5c27a]"></div>

  <p class="text-sm tracking-[0.3em] drop-shadow-lg">
    A CELEBRATION OF LOVE
  </p>

 <a
  href={`${import.meta.env.BASE_URL}/invitation/`}
  class="mt-10 inline-block rounded-full border border-white px-8 py-3 text-sm tracking-[0.25em] text-white transition duration-300 hover:bg-white hover:text-[#315d5a]"
>
  VIEW INVITATION
</a>
  </div>  

</section>