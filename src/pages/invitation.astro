---
import BottomNav from "../components/bottomNav.astro";
import BaseHead from "../components/BaseHead.astro";
import MusicPlayer from "../components/musicplayer.astro";
import Invitation from '../components/invitation.astro';
import Wording from '../components/wording.astro';
import Details from '../components/details.astro';
import Countdown from '../components/countdown.astro';
import Directions from '../components/directions.astro';
import RSVP from '../components/rsvp.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
  title="Isa & Hafizah | Wedding Invitation"
  description="You are warmly invited to celebrate the wedding of Isa Lias and Hafizah."/>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Isa & Hafizah | Wedding Invitation</title>
  </head>
  <body>
    <main class="w-full min-h-dvh snap-y snap-mandatory overflow-y-scroll">
      <section class="snap-start">
        <Invitation />
      </section>
      <section class="snap-start">
        <Wording />
      </section>
      <section class="snap-start">
        <Details />
      </section>
      <section class="snap-start">
        <Countdown />
      </section>
      <section class="snap-start">
        <Directions />
      </section>
      <section class="snap-start">
        <RSVP />
      </section>
    </main>

    <BottomNav />
    <MusicPlayer />
  </body>
</html>
